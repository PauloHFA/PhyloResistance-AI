FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY pyproject.toml README.md ./
COPY src/ ./src/

RUN pip install --no-cache-dir . && \
    python -m phyloresistance.cli run-all --output-dir data/processed --reports-dir reports --n-isolados 240 --n-boot 50

EXPOSE 8000

CMD ["uvicorn", "phyloresistance.api.app:app", "--host", "0.0.0.0", "--port", "8000"]

